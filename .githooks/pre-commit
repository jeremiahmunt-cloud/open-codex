#!/bin/sh
# Git for Windows supplies this shell. No pip packages or hook framework needed.
root=$(git rev-parse --show-toplevel) || exit 2
if command -v py >/dev/null 2>&1; then
    exec py -3 "$root/tools/check_privacy.py"
elif command -v python3 >/dev/null 2>&1; then
    exec python3 "$root/tools/check_privacy.py"
elif command -v python >/dev/null 2>&1; then
    exec python "$root/tools/check_privacy.py"
fi
printf '%s\n' 'Privacy check requires Python 3.10+ (py -3, python3, or python).' >&2
exit 2
